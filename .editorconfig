# EditorConfig is awesome: https://EditorConfig.org
root = true

[*]
# Sensible defaults for all files.
charset = utf-8
end_of_line = lf
insert_final_newline = true

# Sensible indent style.
indent_style = space
indent_size = 2

# Matches e.g., `dot_config/git/config.tmpl` and `dot_config/git/ignore`.
[**/git/*{,.tmpl}]
indent_style = tab

[*.fish]
indent_size = 4
